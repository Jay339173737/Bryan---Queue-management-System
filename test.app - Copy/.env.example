# PayMongo test/sandbox keys - get these from your PayMongo dashboard,
# under "Developers" -> "API Keys". Use the pk_test_/sk_test_ ones, not live.
PAYMONGO_SECRET_KEY=sk_test_paste_your_real_key_here

# Get this from PayMongo dashboard -> "Developers" -> "Webhooks", after you
# create a webhook endpoint (see instructions below). It starts with "whsk_".
PAYMONGO_WEBHOOK_SECRET=whsk_paste_your_real_secret_here
